# Variables del servicio del Panel docente BIC (copiar a /etc/panel-bic/panel.env)
# Clave compartida del personal docente. Usar una cadena larga y aleatoria:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
TOKEN_DOCENTE=cambiar-por-una-clave-larga
PANEL_DB=/var/lib/panel-bic/panel.db
ORIGENES_PERMITIDOS=https://mauriciocantor-rgb.github.io
RETENCION_DIAS=365
LIMITE_POR_MINUTO=90
CONFIAR_PROXY=1
