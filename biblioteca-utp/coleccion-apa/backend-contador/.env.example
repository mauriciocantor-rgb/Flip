# Copie este archivo como /etc/contador-bic/contador.env y ajuste los valores.

# Archivo SQLite con los conteos (incluirlo en la copia de seguridad del servidor)
CONTADOR_DB=/var/lib/contador-bic/contador.db

# Orígenes del navegador autorizados a registrar visitas (CORS), separados por coma.
# Agregue el dominio del campus virtual si las herramientas se embeben allí
# directamente desde otro origen (las páginas embebidas siguen llamando desde github.io).
ORIGENES_PERMITIDOS=https://mauriciocantor-rgb.github.io

# Máximo de visitas registradas por cliente y herramienta cada 60 segundos
LIMITE_POR_MINUTO=20

# 1 si el servicio queda detrás de nginx/Apache (usa X-Forwarded-For para el límite)
CONFIAR_PROXY=1
